{
  "rules": {
    // Who may see the admin area.
    //
    // Two ways in, and they differ on purpose. One address — the owner's — is
    // written into the rules, because admin is stored in the database and a
    // rule that only ever consults the database can never grant the first one.
    // Everybody else is a row here, written by somebody who already has it.
    //
    // Verification is not required of that address. Firebase Auth will not
    // issue two accounts for one email, so it can only belong to whoever
    // registered it first, and requiring a verified token would lock the owner
    // out until they clicked a link that email/password sign-up never sends.
    //
    // Adding an admin is open to any admin; removing one is the owner's alone.
    // Otherwise somebody let in could turn round and shut out the people who
    // let them in. The owner holds admin by email rather than by a row, so
    // there is no row to delete and no way to lock the last person out.
    "admins": {
      ".read": "auth != null && (auth.token.email == 'alexleyvalp@gmail.com' || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        // Each player may read their own row and no other — which is how a
        // client finds out whether to offer the door at all, without being
        // able to enumerate who else holds it.
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.token.email == 'alexleyvalp@gmail.com' || (newData.exists() && root.child('admins').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['username', 'at'])"
      }
    },

    // First-run survey answers, one record per player.
    //
    // They are kept here rather than on the profile because a profile is
    // readable by every signed-in user — that is what lets a room show names —
    // and what somebody said about their school year and their goals is not.
    // Read by its owner, read in full by an admin, written by nobody else.
    //
    // A record may be rewritten: somebody who skipped can come back and answer
    // it from their profile, and there is nothing here worth freezing.
    "surveys": {
      ".read": "auth != null && (auth.token.email == 'alexleyvalp@gmail.com' || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChild('at')",
        "at": { ".validate": "newData.isNumber()" },
        "skipped": { ".validate": "newData.isBoolean()" },
        "answers": {
          // A ceiling on the free-text field, so the one place a player can
          // type freely cannot be used to store something else entirely.
          "$question": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          }
        }
      }
    },

    // A player's profile and progress: readable by any signed-in user so
    // rooms can show names, writable only by its owner. An admin may read the
    // node whole, which is the only way to count accounts or list them.
    //
    // Because every signed-in user can read a row here, nothing personal may
    // be kept in one. An email in particular: /usernames maps a name to a uid
    // and is readable by any signed-in user too, so an address stored here
    // would be an address book anybody who signed up could walk. Firebase Auth
    // already holds the address, and /api/admin/accounts is what joins it back
    // on for the one screen that needs it.
    "users": {
      ".read": "auth != null && (auth.token.email == 'alexleyvalp@gmail.com' || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",

        // The name has to hold its shape here as well as in the index, or a
        // profile could show one thing while the claim held another.
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z][A-Za-z0-9_]{2,15}$/)"
        },

        // Nothing may write an email here, ever. Sign-up used to, and a client
        // running that build is still out there; a validate that can never
        // pass fails the whole write rather than letting the field through.
        // Deleting one is not a write of it — newData does not exist, so this
        // does not run — which is what lets the old rows be cleaned out.
        "email": {
          ".validate": false
        }
      }
    },

    // The username index: name -> uid, and the whole of what makes a username
    // unique. Globally readable by signed-in users because finding a friend by
    // name is a read of exactly one key here, and it holds nothing else.
    //
    // A key may be written only when it does not already exist, and only with
    // the writer's own uid. That makes claiming a name a single write that
    // either wins or fails — no read-then-write, which two people signing up at
    // the same moment can both pass. It also makes a claim permanent: the same
    // condition refuses a delete, so a name cannot be released and re-taken
    // out from under whoever is playing under it.
    "usernames": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && !data.exists() && newData.val() == auth.uid",
        ".validate": "newData.isString() && $key.matches(/^[a-z][a-z0-9_]{2,15}$/)"
      }
    },

    // Friends, keyed by whose list it is. Read permission cascades downward in
    // this database, so one shared list of every friendship would be readable
    // in full by anyone allowed to read a single row of it — hence a list per
    // player, each readable only by its owner.
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$other": {
          // You may edit your own list freely. Somebody else may write
          // themselves into it only while your request to them is standing —
          // which is what accepting a request is — and may remove themselves
          // from it at any time, so that ending a friendship can clear both
          // sides rather than leaving a row nobody is able to delete.
          ".write": "auth != null && (auth.uid == $uid || (auth.uid == $other && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($uid).exists())))",
          ".validate": "!newData.exists() || newData.hasChildren(['username'])"
        }
      }
    },

    // Incoming friend requests, again keyed by who receives them. The sender
    // writes one row and can withdraw it; the receiver can read the lot and
    // clear any of them, which is both accepting and declining.
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$from": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $from)",
          ".validate": "!newData.exists() || newData.hasChildren(['username'])"
        }
      }
    },

    // Room invitations. Only a friend can send one, checked here rather than
    // trusted from the client, so an invitation cannot be used to reach a
    // stranger. One row per sender: inviting somebody twice replaces the
    // invitation rather than filling their screen with them.
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$from": {
          ".write": "auth != null && (auth.uid == $uid || (auth.uid == $from && root.child('friends').child($uid).child($from).exists()))",
          ".validate": "!newData.exists() || newData.hasChildren(['roomId', 'code', 'username'])"
        }
      }
    },

    // Session history is private to the player it belongs to.
    "results": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // Code -> room lookup. The only globally readable thing, and it holds no
    // game data: a code, the room it points at, who owns it, and whether it is
    // still open. It records its own hostUid so that creating, closing and
    // deleting a code are all decidable without reading another node.
    "roomCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() == auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['roomId', 'hostUid', 'status'])"
      }
    },

    "rooms": {
      "$roomId": {
        // Readable only by people actually in the room. A joiner gets in by
        // writing their own seat first (permitted below), which then makes
        // this rule true for them.
        ".read": "auth != null && (data.child('hostUid').val() == auth.uid || data.child('players').child(auth.uid).exists())",

        // The host creates the room, runs it, and deletes it when it is done.
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() == auth.uid)",

        "players": {
          // Any signed-in player may claim or release their own seat.
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },

    // Grading sessions. Denied to everybody, including signed-in users and the
    // player the session belongs to: a session records which questions were
    // served and which positions have already been graded, and being able to
    // read either is enough to work around the one-verdict-per-position rule.
    //
    // The server reaches this node with the Admin SDK, which bypasses rules
    // entirely, so denying it here costs nothing and closes it to every client.
    // Deny-by-default would cover this too; it is written out because a node
    // that nothing may read is worth saying on purpose rather than by omission.
    "sessions": {
      ".read": false,
      ".write": false
    },

    // Per-caller rate-limit counters — session minting and grading, on
    // separate keys — bucketed by time window. Same reasoning: server-only,
    // and readable by nobody.
    "mints": {
      ".read": false,
      ".write": false
    },

    // Answers live outside the room on purpose. Read permission in this
    // database cascades downward and cannot be revoked on a child, so an
    // answers node inside the room would be readable by everyone who can
    // read the room — letting a player see what their opponents picked
    // before the reveal.
    "roomAnswers": {
      "$roomId": {
        // The host reads the whole set to resolve a question, and clears it
        // when the room is torn down. This does not widen what a bad host can
        // do — a host that resolves rounds is already trusted with the result.
        ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
        ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",

        "$index": {
          "$uid": {
            // You can read your own answer back, write it exactly once, and
            // never overwrite it — this is what stops an answer being
            // changed after the reveal.
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && !data.exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['response'])"
          }
        }
      }
    }
  }
}
